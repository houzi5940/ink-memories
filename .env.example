# InkMemories 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================================
# VLM API 配置（必填）
# ============================================================

# DeepSeek API（推荐，性价比高）
# 申请地址: https://platform.deepseek.com/
VLM_API_URL=https://api.deepseek.com/v1/chat/completions
VLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
VLM_MODEL=deepseek-chat

# 通义千问 API（备选）
# VLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# VLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# VLM_MODEL=qwen-vl-max

# 智谱 GLM-4V（备选，有免费额度）
# VLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# VLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# VLM_MODEL=glm-4v-flash

# ============================================================
# 分析参数
# ============================================================

# 并发数（建议 2-4，过多可能触发 API 限流）
CONCURRENCY=2

# 每次最多分析几张（0 = 不限制）
BATCH_LIMIT=0

# 单张照片 API 超时（秒）
TIMEOUT=120
